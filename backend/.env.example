PORT=8080

# Comma-separated list of allowed frontend origins for CORS. Leave unset to
# allow all origins (fine for local dev; lock this down in production).
CORS_ALLOWED_ORIGINS=

# Firebase Admin SDK service account (leave unset to use Application Default
# Credentials on Cloud Run, or the Firebase emulator suite locally)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-side only — never exposed to the frontend
ANTHROPIC_API_KEY=

# Evidence providers (Phase 3+). ADAPTER=mock until real endpoints are ready.
PROMETHEUS_ADAPTER=mock
PROMETHEUS_BASE_URL=
GRAFANA_ADAPTER=mock
GRAFANA_BASE_URL=
GRAFANA_API_KEY=

# Historical incident embeddings. mock = local hashing, no key needed; live = Voyage AI.
# Switching adapters changes embedding dimensionality — re-run `npm run seed:historical`
# after switching, or similarity search will compare vectors from different spaces.
EMBEDDING_ADAPTER=mock
VOYAGE_API_KEY=

# Alert ingestion
MOCK_ALERT_GENERATOR_ENABLED=true
MOCK_ALERT_RATE_MS=20000

# Shared secret required on POST /api/alerts/ingest (X-Ingest-Key header).
# Leave unset in local dev to allow unauthenticated ingestion.
INGEST_API_KEY=
